---
/**
 * Standard page shell: Navbar + centered <main> + search modal.
 * Variants:
 * - `proseClass`: typography class applied to <main> (default "type-standard";
 *   NoteLayout passes "typography").
 * - `fullWidth`: drop the max-width/prose styling (admin pages).
 * - `noSearch`: omit the search modal (admin pages).
 * - `noNav`: omit the navbar (404, whose own links cover home and search).
 * - `skylineFooter`: show the Indy skyline illustration flush under the
 *   content (homepage only); other pages keep bottom padding instead.
 * - `wide`: a wider column (navbar included) for tools that need room,
 *   e.g. /cleanshot.
 * Slots: default (main content), "head" (extra <head> tags),
 * "before-nav" (e.g. the note scroll-progress bar).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import SearchModal from "@/components/SearchModal.astro";
import SkylineFooter from "@/components/SkylineFooter.astro";

interface Props {
    title?: string;
    description?: string;
    image?: URL | string;
    canonicalURL?: URL | string;
    noindex?: boolean;
    proseClass?: string;
    fullWidth?: boolean;
    noSearch?: boolean;
    noNav?: boolean;
    skylineFooter?: boolean;
    wide?: boolean;
}

const {
    title,
    description,
    image,
    canonicalURL,
    noindex,
    proseClass = "type-standard",
    fullWidth = false,
    noSearch = false,
    noNav = false,
    skylineFooter = false,
    wide = false,
} = Astro.props;

const mainClass = fullWidth
    ? "px-4 flex-1"
    : `px-6 md:px-4 ${skylineFooter ? "" : "pb-16"} mt-4 md:mt-6 flex-1 mx-auto w-full ${wide ? "max-w-[68rem]" : "max-w-[38rem]"} ${proseClass}`;
---

<BaseLayout
    title={title}
    description={description}
    image={image}
    canonicalURL={canonicalURL}
    noindex={noindex}
>
    <slot name="head" slot="head" />
    <slot name="before-nav" />
    {!noNav && <Navbar wide={wide} />}
    <main class={mainClass}>
        <slot />
    </main>
    {skylineFooter && <SkylineFooter />}
    {!noSearch && <SearchModal />}
</BaseLayout>
