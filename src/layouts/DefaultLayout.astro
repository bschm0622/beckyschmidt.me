---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import SearchModal from "@/components/SearchModal.astro";
import SkylineFooter from "@/components/SkylineFooter.astro";

interface Props {
    title?: string;
    description?: string;
    image?: URL | string;
    canonicalURL?: URL | string;
    noindex?: boolean;
    proseClass?: string;
    fullWidth?: boolean;
    noSearch?: boolean;
    noNav?: boolean;
    skylineFooter?: boolean;
    wide?: boolean;
}

const {
    title,
    description,
    image,
    canonicalURL,
    noindex,
    proseClass = "type-standard",
    fullWidth = false,
    noSearch = false,
    noNav = false,
    skylineFooter = false,
    wide = false,
} = Astro.props;

const mainClass = fullWidth
    ? "px-4 flex-1"
    : `px-6 md:px-4 ${skylineFooter ? "" : "pb-16"} mt-4 md:mt-6 flex-1 mx-auto w-full ${wide ? "max-w-[68rem]" : "max-w-[38rem]"} ${proseClass}`;
---

<BaseLayout
    title={title}
    description={description}
    image={image}
    canonicalURL={canonicalURL}
    noindex={noindex}
>
    <slot name="head" slot="head" />
    {!noNav && <Navbar wide={wide} />}
    <main class={mainClass}>
        <slot />
    </main>
    {skylineFooter && <SkylineFooter />}
    {!noSearch && <SearchModal />}
</BaseLayout>
