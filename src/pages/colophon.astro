---
export const prerender = false;
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import TrafficChart from "@/components/TrafficChart.astro";
import { Content, frontmatter } from "@/story/colophon.md";
import { publicTraffic } from "@/lib/analytics/stats";

// Rendered per request for the live traffic chart; publicTraffic() caches the query.
let traffic = null;
try {
    traffic = await publicTraffic();
} catch (error) {
    console.error("Colophon traffic chart failed:", error);
}
Astro.response.headers.set("Cache-Control", "public, max-age=300");
---

<DefaultLayout title={frontmatter.title} description={frontmatter.description} proseClass="typography">
    <h1>{frontmatter.title}</h1>
    <p class="text-sm text-muted-foreground">
        Last updated <FormattedDate date={new Date(frontmatter.updated)} />
    </p>
    <div class="icon-links">
        <Content />
    </div>
    {traffic && (
        <div class="mt-6">
            <TrafficChart data={traffic.days} visitors={traffic.visitors} />
        </div>
    )}
</DefaultLayout>
