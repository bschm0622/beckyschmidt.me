---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { Content, frontmatter } from "@/story/colophon.md";
---

<DefaultLayout title={frontmatter.title} description={frontmatter.description} proseClass="typography">
    <h1>{frontmatter.title}</h1>
    <p class="text-sm text-muted-foreground">
        Last updated <FormattedDate date={new Date(frontmatter.updated)} />
    </p>
    <div class="icon-links">
        <Content />
    </div>
</DefaultLayout>

