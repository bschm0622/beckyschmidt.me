---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { Button } from "@/components/starwind/button";
import ToggleGroup from "@/components/starwind/toggle-group";
import { Dropzone, DropzoneUploadIndicator } from "@/components/starwind/dropzone";
import { Collapsible, CollapsibleTrigger, CollapsibleContent } from "@/components/starwind/collapsible";
import { Tooltip, TooltipTrigger, TooltipContent } from "@/components/starwind/tooltip";
import ColorPicker from "@tabler/icons/outline/color-picker.svg";
import CropIcon from "@tabler/icons/outline/crop.svg";
import EyeOff from "@tabler/icons/outline/eye-off.svg";
import Undo from "@tabler/icons/outline/arrow-back-up.svg";
import Redo from "@tabler/icons/outline/arrow-forward-up.svg";
import ChevronDown from "@tabler/icons/outline/chevron-down.svg";
import ArrowIcon from "@tabler/icons/outline/arrow-up-right.svg";
import TextIcon from "@tabler/icons/outline/letter-t.svg";
import { PRESETS } from "@/lib/cleanshot/backgrounds";
import { SIZES, PADDING_CHOICES, RADIUS_CHOICES, SHADOW_CHOICES, FRAME_CHOICES, ANNOTATION_COLORS, type Choice } from "@/lib/cleanshot/render";

const title = "CleanShot";
const description = "Put a screenshot on a clean background, sized for X, LinkedIn or Instagram. Free, and it runs in your browser, so your image is never uploaded.";
const accept = "image/png,image/jpeg,image/webp,image/gif,image/heic";

const optionRows: { key: string; label: string; choices: Choice[] }[] = [
    { key: "padding", label: "Padding", choices: PADDING_CHOICES },
    { key: "radius", label: "Corners", choices: RADIUS_CHOICES },
    { key: "shadow", label: "Shadow", choices: SHADOW_CHOICES },
    { key: "frame", label: "Frame", choices: FRAME_CHOICES },
];
const formats: Choice[] = [
    { id: "png", label: "PNG" },
    { id: "jpeg", label: "JPEG" },
    { id: "webp", label: "WebP" },
];
const scales: Choice[] = [
    { id: "1", label: "1×" },
    { id: "2", label: "2×" },
    { id: "3", label: "3×" },
];
const tools: Choice[] = [
    { id: "arrow", label: "Arrow" },
    { id: "text", label: "Text" },
];
const colorNames: Record<string, string> = { red: "Red", yellow: "Yellow", blue: "Blue", green: "Green", black: "Black", white: "White" };
const redactStyles: Choice[] = [
    { id: "box", label: "Box" },
    { id: "pixelate", label: "Pixelate" },
];
const row = "space-y-2";
const rowLabel = "text-sm text-muted-foreground";
---

<DefaultLayout title={title} description={description} wide>
    <div class="space-y-8">
        <header class="space-y-1">
            <h1>CleanShot</h1>
            <p class="text-muted-foreground">Frame a screenshot for sharing.</p>
        </header>

        <div data-empty class="space-y-3">
            <Dropzone accept={accept} aria-label="Choose a screenshot" class="py-28">
                <DropzoneUploadIndicator>
                    <p class="text-base text-foreground">Paste, drop, or choose a screenshot</p>
                </DropzoneUploadIndicator>
            </Dropzone>
            <div class="flex items-center justify-between gap-4">
                <p class="text-sm text-muted-foreground">Your image never leaves your browser.</p>
                <Button data-paste variant="ghost" size="sm">Paste</Button>
            </div>
            <p data-status role="status" aria-live="polite" class="text-sm text-muted-foreground min-h-5"></p>
        </div>

        <div data-loaded hidden class="space-y-8 lg:grid lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start lg:gap-12 lg:space-y-0">
            <div class="sticky top-0 z-10 -mx-1 space-y-2 bg-background px-1 pt-3 pb-1 lg:top-4 lg:pt-0">
                <div data-stage>
                    <div class="checker relative mx-auto w-fit max-w-full overflow-hidden rounded-lg">
                        <canvas data-preview role="img" class="block max-w-full max-h-[45vh] lg:max-h-[calc(100vh-8rem)]"></canvas>
                        <div data-overlay hidden class="absolute inset-0 touch-none select-none"></div>
                    </div>
                </div>

                <div data-toolbar class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1">
                        <Button data-crop variant="ghost" size="sm"><CropIcon aria-hidden="true" />Crop</Button>
                        <Button data-redact variant="ghost" size="sm"><EyeOff aria-hidden="true" />Redact</Button>
                        <Button data-arrow variant="ghost" size="sm"><ArrowIcon aria-hidden="true" />Arrow</Button>
                        <Button data-text variant="ghost" size="sm"><TextIcon aria-hidden="true" />Text</Button>
                        <Tooltip openDelay={0} closeDelay={0}>
                            <TooltipTrigger>
                                <Button data-undo variant="ghost" size="icon-sm" aria-label="Undo" disabled><Undo aria-hidden="true" /></Button>
                            </TooltipTrigger>
                            <TooltipContent>Undo ⌘Z</TooltipContent>
                        </Tooltip>
                        <Tooltip openDelay={0} closeDelay={0}>
                            <TooltipTrigger>
                                <Button data-redo variant="ghost" size="icon-sm" aria-label="Redo" disabled><Redo aria-hidden="true" /></Button>
                            </TooltipTrigger>
                            <TooltipContent>Redo ⇧⌘Z</TooltipContent>
                        </Tooltip>
                    </div>
                    <Button data-replace variant="ghost" size="sm">Replace</Button>
                </div>

                <div data-modebar hidden class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-3">
                        <div data-annotate-tools hidden class="flex items-center gap-3">
                            <ToggleGroup.Root data-group="tool" size="sm" spacing={1} aria-label="Tool">
                                {tools.map((c) => <ToggleGroup.Item value={c.id}>{c.label}</ToggleGroup.Item>)}
                            </ToggleGroup.Root>
                            <ToggleGroup.Root data-group="color" size="sm" spacing={0} aria-label="Color">
                                {Object.entries(ANNOTATION_COLORS).map(([id, hex]) => (
                                    <Tooltip openDelay={0} closeDelay={0}>
                                        <TooltipTrigger>
                                            <ToggleGroup.Item value={id} aria-label={colorNames[id]}>
                                                <span class="size-4 rounded-full ring-1 ring-foreground/15 dark:ring-foreground/35" style={`background:${hex}`}></span>
                                            </ToggleGroup.Item>
                                        </TooltipTrigger>
                                        <TooltipContent>{colorNames[id]}</TooltipContent>
                                    </Tooltip>
                                ))}
                            </ToggleGroup.Root>
                        </div>
                        <div data-redact-styles hidden>
                            <ToggleGroup.Root data-group="redact" size="sm" spacing={1} aria-label="Redaction style">
                                {redactStyles.map((c) => <ToggleGroup.Item value={c.id}>{c.label}</ToggleGroup.Item>)}
                            </ToggleGroup.Root>
                        </div>
                        <p data-mode-hint class="text-sm text-muted-foreground"></p>
                    </div>
                    <div class="flex shrink-0 items-center gap-1">
                        <Button data-mode-reset variant="ghost" size="sm">Reset</Button>
                        <Button data-mode-done size="sm">Done</Button>
                    </div>
                </div>
            </div>

            <div class="space-y-6">
                <div class={row}>
                    <p class={rowLabel}>Background</p>
                    <ToggleGroup.Root data-group="background" size="sm" spacing={1} aria-label="Background" class="flex-wrap">
                        {PRESETS.map((p) => (
                            <Tooltip openDelay={0} closeDelay={0}>
                                <TooltipTrigger>
                                    <ToggleGroup.Item value={p.id} aria-label={p.name}>
                                        {p.id === "picked" ? (
                                            <span class="relative grid place-items-center">
                                                <canvas data-swatch={p.id} width="48" height="48" class="size-6 rounded-full ring-1 ring-foreground/10 dark:ring-foreground/35"></canvas>
                                                <ColorPicker data-dropper-icon class="absolute size-3.5" aria-hidden="true" />
                                            </span>
                                        ) : (
                                            <canvas data-swatch={p.id} width="48" height="48" class="size-6 rounded-full ring-1 ring-foreground/10 dark:ring-foreground/35"></canvas>
                                        )}
                                    </ToggleGroup.Item>
                                </TooltipTrigger>
                                <TooltipContent>{p.name}</TooltipContent>
                            </Tooltip>
                        ))}
                    </ToggleGroup.Root>
                </div>

                <div class={row}>
                    <p class={rowLabel}>Size</p>
                    <ToggleGroup.Root data-group="size" size="sm" spacing={1} aria-label="Size" class="flex-wrap">
                        {SIZES.map((s) => <ToggleGroup.Item value={s.id}>{s.label}</ToggleGroup.Item>)}
                    </ToggleGroup.Root>
                    <p data-size-note class="text-sm text-muted-foreground"></p>
                </div>

                <div class="flex flex-wrap gap-2">
                    <Button data-copy size="sm" class="flex-1">Copy image</Button>
                    <Button data-download variant="outline" size="sm">Download</Button>
                    <Button data-share variant="outline" size="sm" hidden>Share</Button>
                </div>

                <Collapsible class="space-y-5">
                    <CollapsibleTrigger asChild>
                        <Button variant="ghost" size="sm">
                            More options
                            <ChevronDown aria-hidden="true" class="transition-transform in-aria-expanded:rotate-180" />
                        </Button>
                    </CollapsibleTrigger>

                    <CollapsibleContent>
                        <div class="space-y-5">
                            {optionRows.map((r) => (
                                <div class={row}>
                                    <p class={rowLabel}>{r.label}</p>
                                    <ToggleGroup.Root data-group={r.key} size="sm" spacing={1} aria-label={r.label} class="flex-wrap">
                                        {r.choices.map((c) => <ToggleGroup.Item value={c.id}>{c.label}</ToggleGroup.Item>)}
                                    </ToggleGroup.Root>
                                </div>
                            ))}
                            <div class={row}>
                                <p class={rowLabel}>Export</p>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                                    <ToggleGroup.Root data-group="format" size="sm" spacing={1} aria-label="Format">
                                        {formats.map((c) => <ToggleGroup.Item value={c.id}>{c.label}</ToggleGroup.Item>)}
                                    </ToggleGroup.Root>
                                    <ToggleGroup.Root data-group="scale" size="sm" spacing={1} aria-label="Scale">
                                        {scales.map((c) => <ToggleGroup.Item value={c.id}>{c.label}</ToggleGroup.Item>)}
                                    </ToggleGroup.Root>
                                </div>
                            </div>
                        </div>
                    </CollapsibleContent>
                </Collapsible>

                <p data-status role="status" aria-live="polite" class="text-sm text-muted-foreground min-h-5"></p>
            </div>
        </div>

        <input data-file type="file" accept={accept} hidden />
    </div>
</DefaultLayout>

<style is:global>
    .checker {
        background: repeating-conic-gradient(var(--color-muted) 0 25%, transparent 0 50%) 0 0 / 16px 16px;
    }

    .crop-box {
        position: absolute;
        cursor: move;
        outline: 1px solid rgb(255 255 255 / 0.9);
        box-shadow: 0 0 0 9999px rgb(0 0 0 / 0.5);
    }
    .crop-handle {
        position: absolute;
        width: 12px;
        height: 12px;
        margin: -6px 0 0 -6px;
        border-radius: 2px;
        background: #fff;
        box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25);
    }
    @media (pointer: coarse) {
        .crop-handle {
            width: 20px;
            height: 20px;
            margin: -10px 0 0 -10px;
        }
    }
    .crop-n, .crop-s { left: 50%; cursor: ns-resize; }
    .crop-e, .crop-w { top: 50%; cursor: ew-resize; }
    .crop-n, .crop-ne, .crop-nw { top: 0; }
    .crop-s, .crop-se, .crop-sw { top: 100%; }
    .crop-w, .crop-nw, .crop-sw { left: 0; }
    .crop-e, .crop-ne, .crop-se { left: 100%; }
    .crop-nw, .crop-se { cursor: nwse-resize; }
    .crop-ne, .crop-sw { cursor: nesw-resize; }

    [data-overlay][data-mode="redact"],
    [data-overlay][data-mode="annotate"][data-tool="arrow"] {
        cursor: crosshair;
    }
    [data-overlay][data-mode="annotate"][data-tool="text"] {
        cursor: text;
    }
    .redact-box {
        position: absolute;
        cursor: move;
        outline: 1.5px dashed rgb(255 255 255 / 0.95);
        box-shadow: 0 0 0 1px rgb(0 0 0 / 0.3);
    }
    .redact-box .crop-handle {
        opacity: 0;
        transition: opacity 120ms;
    }
    .redact-box:hover .crop-handle {
        opacity: 1;
    }
    .redact-draft {
        background: rgb(255 255 255 / 0.15);
    }
    .redact-remove {
        position: absolute;
        top: -10px;
        right: -10px;
        width: 20px;
        height: 20px;
        display: grid;
        place-items: center;
        border-radius: 9999px;
        background: #1c1917;
        color: #fff;
        font-size: 14px;
        line-height: 1;
        cursor: pointer;
    }

    .arrow-handle {
        position: absolute;
        width: 14px;
        height: 14px;
        margin: -7px 0 0 -7px;
        border-radius: 9999px;
        background: #fff;
        box-shadow: 0 0 0 1.5px rgb(0 0 0 / 0.35), 0 1px 3px rgb(0 0 0 / 0.25);
        cursor: grab;
    }
    .arrow-remove {
        position: absolute;
        width: 0;
        height: 0;
    }
    .arrow-remove .redact-remove {
        top: -30px;
        right: auto;
        left: -10px;
    }
    .text-box {
        position: absolute;
        cursor: move;
        outline: 1.5px dashed rgb(255 255 255 / 0.95);
        outline-offset: 4px;
        box-shadow: 0 0 0 5px rgb(0 0 0 / 0.0), 0 0 0 5.5px rgb(0 0 0 / 0.3);
    }
    .text-box .redact-remove {
        top: -16px;
        right: -16px;
    }
    .text-editor {
        position: absolute;
        min-width: 1ch;
        white-space: pre;
        line-height: 1.2;
        outline: 1.5px dashed rgb(0 0 0 / 0.4);
        outline-offset: 4px;
        cursor: text;
        caret-color: currentColor;
    }
</style>

<script>
    import { initCleanShot } from "@/lib/cleanshot/app";
    initCleanShot();
</script>
