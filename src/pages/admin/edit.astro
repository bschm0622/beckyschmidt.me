---
export const prerender = false
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import NoteEditor from '@/components/NoteEditor.tsx';
import { GITHUB_OWNER, GITHUB_REPO } from 'astro:env/server';
---

{/* Same wide column as the navbar, like the other admin pages. */}
<DefaultLayout title="Note Editor" wide proseClass="" noSearch noindex>
  <div class="pb-8">
    <NoteEditor client:load repo={`${GITHUB_OWNER}/${GITHUB_REPO}`} />
  </div>
</DefaultLayout>
