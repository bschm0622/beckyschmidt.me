---
export const prerender = false
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import NoteEditor from '@/components/NoteEditor.tsx';
import { GITHUB_OWNER, GITHUB_REPO } from 'astro:env/server';
---

<DefaultLayout title="Note Editor" fullWidth noSearch noindex>
  <div class="mx-auto w-full max-w-3xl py-8">
    <NoteEditor client:load repo={`${GITHUB_OWNER}/${GITHUB_REPO}`} />
  </div>
</DefaultLayout>
