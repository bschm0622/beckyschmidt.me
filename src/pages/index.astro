---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import NotesReel from "@/components/NotesReel.astro";
import HomeMinimap from "@/components/HomeMinimap.astro";
import { Content as Hero } from "@/story/hero.md";
import { Content as Contact } from "@/story/contact.md";
import { getCollection } from "astro:content";
import { getSortedNotes, formatDate } from "@/lib/notes";
import { SITE } from "@/siteConfig";

const notes = await getSortedNotes();
const noteCount = notes.length;

// Projects list lives in src/data/projects.json.
const projects = (await getCollection("projects"))
  .map((p) => p.data)
  .sort((a, b) => a.order - b.order);

function withUtm(href: string) {
  const url = new URL(href);
  url.searchParams.set("utm_source", "beckyschmidt.me");
  url.searchParams.set("utm_medium", "referral");
  url.searchParams.set("utm_campaign", "portfolio");
  return url.toString();
}

// Minimap card facts (HomeMinimap.astro). Derived from data so they never
// drift from the page; nothing here is hand-written copy.
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const minimap = {
  about: `${SITE.jobTitle}, ${SITE.location.locality}`,
  projects: plural(projects.length, "project"),
  notes: noteCount === 0
    ? "Coming soon"
    : `${plural(noteCount, "note")}, latest ${formatDate(notes[0].data.pubDate, "month-year")}`,
  contact: "Email or LinkedIn",
};

// All homepage copy lives in src/story/*.md.
---

<DefaultLayout
  title="Home"
  description="Becky Schmidt is a senior product manager who builds: AI products at Octane11 by day, her own production systems at night."
  skylineFooter={true}
>
  <div class="mx-auto w-full space-y-14">

    <!-- Story: edit src/story/hero.md -->
    <section data-minimap-title="About" data-minimap-text={minimap.about}>
      <img
        src="/becky.png"
        alt="Becky Schmidt"
        width="64"
        height="64"
        class="size-16 rounded-full! object-cover mb-5"
      />
      <div class="typography">
        <Hero />
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="space-y-3" data-minimap-title="Projects" data-minimap-text={minimap.projects}>
      <h2 class="text-2xl font-medium leading-[1.3] tracking-tight text-foreground">Projects</h2>
      <div class="space-y-3">
        {projects.map((project) => (
          <a
            href={withUtm(project.href)}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start justify-between gap-4 rounded-md border border-muted p-4 no-underline! transition-colors hover:border-foreground/30"
          >
            <div class="min-w-0">
              <p class="text-base font-medium text-foreground leading-snug group-hover:underline decoration-1">{project.name}</p>
              <p class="text-base text-muted-foreground mt-1 leading-snug">{project.description}</p>
            </div>
            <svg class="size-3 shrink-0 mt-1 text-muted-foreground group-hover:text-link transition-colors" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
              <path fill="currentColor" d="M10 6v2H5v11h11v-5h2v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zm11-3v8h-2V6.413l-7.793 7.794l-1.414-1.414L17.585 5H13V3z" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Notes -->
    <section class="space-y-3" data-minimap-title="Notes" data-minimap-text={minimap.notes}>
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-medium leading-[1.3] tracking-tight text-foreground">Notes</h2>
        {noteCount > 5 && (
          <a href="/notes" class="text-sm text-muted-foreground! hover:text-foreground! transition-colors no-underline!">View all ({noteCount}) →</a>
        )}
      </div>
      <NotesReel preview={true} showTags={false} />
    </section>

    <!-- Contact / closing CTA: edit src/story/contact.md. Contact links come
         from siteConfig so the address lives in one place. -->
    <section class="typography" data-minimap-title="Get in touch" data-minimap-text={minimap.contact}>
      <Contact />
      <p>
        <a href={`mailto:${SITE.email}`}>Email me</a> or find me on
        <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
      </p>
    </section>

  </div>
  <HomeMinimap />
</DefaultLayout>
