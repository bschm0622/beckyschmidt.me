---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import NotesReel from "@/components/NotesReel.astro";
import { Content as Hero } from "@/story/hero.md";
import { getCollection } from "astro:content";
import { getSortedNotes } from "@/lib/notes";
import { SITE } from "@/siteConfig";

const notes = await getSortedNotes();
const noteCount = notes.length;

// Projects list lives in src/data/projects.json.
const projects = (await getCollection("projects"))
  .map((p) => p.data)
  .sort((a, b) => a.order - b.order);

function withUtm(href: string) {
  const url = new URL(href);
  url.searchParams.set("utm_source", "beckyschmidt.me");
  url.searchParams.set("utm_medium", "referral");
  url.searchParams.set("utm_campaign", "portfolio");
  return url.toString();
}

// External projects (UTM-tagged, new tab) followed by internal rows: the
// /mini-tools index (tools are listed in src/data/mini-tools.json) and this
// site, which links to the colophon.
const projectRows = [
  ...projects.map((p) => ({ name: p.name, href: withUtm(p.href), description: p.description, icon: p.icon, external: true })),
  { name: "Mini tools", href: "/mini-tools", description: "Custom tools built for my own workflows, hosted here.", icon: "/project-icons/mini-tools.svg", external: false },
  { name: "beckyschmidt.me", href: "/colophon", description: "My personal site. Learn more about how it's built.", icon: "/favicon.svg", external: false },
];

// All homepage copy lives in src/story/*.md.

---

<DefaultLayout skylineFooter={true}>
  <div class="mx-auto w-full space-y-12 pb-16">

    {/* Intro. Copy: src/story/hero.md; the closing line is here so contact links come from siteConfig. */}
    <section>
      <div class="flex items-center gap-4 mb-6">
        <img
          src={SITE.headshot}
          alt=""
          width="64"
          height="64"
          class="size-16 rounded-full! object-cover"
        />
        <h1>{SITE.name}</h1>
      </div>
      <div class="typography icon-links">
        <Hero />
        <p>
          I'm open to remote opportunities on a small team building an AI-native product. You can reach me by
          <a href={`mailto:${SITE.email}`}><img src="/tool-icons/email.svg" alt="" />email</a>, on
          <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer"><img src="/tool-icons/linkedin.svg" alt="" />LinkedIn</a>, or on
          <a class="icon-only" href={SITE.socials.x} target="_blank" rel="noopener noreferrer" aria-label="X"><img src="/tool-icons/x.svg" alt="" /><span class="sr-only">X</span></a>.
        </p>
      </div>
    </section>

    {/* Projects */}
    <section id="projects" class="space-y-3">
      <h2>Projects</h2>
      <div>
        {projectRows.map((row) => (
          <a
            href={row.href}
            target={row.external ? "_blank" : undefined}
            rel={row.external ? "noopener noreferrer" : undefined}
            class="group flex items-start gap-3 py-2 no-underline!"
          >
            {row.icon && (
              <img src={row.icon} alt="" width="20" height="20" loading="lazy" class="brand-icon size-5 shrink-0 mt-px rounded" />
            )}
            <div class="min-w-0">
              <p class="text-base font-medium text-foreground leading-snug group-hover:underline decoration-1">{row.name}</p>
              <p class="text-sm text-muted-foreground mt-0.5 leading-snug">{row.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* Notes */}
    <section class="space-y-3">
      <div class="flex items-baseline justify-between">
        <h2>Notes</h2>
        {noteCount > 5 && (
          <a href="/notes" class="text-sm text-muted-foreground! hover:text-foreground! transition-colors no-underline!">View all ({noteCount}) →</a>
        )}
      </div>
      <NotesReel preview={true} showTags={false} />
    </section>

  </div>
</DefaultLayout>
