---
/**
 * Footer: a black-and-white ink sketch of the Indy skyline, with the local
 * clock underneath.
 *
 * The sketch is black line art on a transparent background, so it sits on
 * the page background as-is and simply inverts to white lines in dark mode.
 *
 * Image is 1536x362 (aspect 4.243). It scales to full width at every size
 * (no side cropping on mobile, so every landmark stays in view), capped at
 * 1400px on wide screens.
 */
import LocalTime from "@/components/LocalTime.astro";
---

<footer id="skyline-footer" class="relative w-full shrink-0 overflow-hidden flex flex-col items-center">
    {/* shrink-0 prevents the flex-col body from collapsing this to 0 height */}
    <div class="relative w-full max-w-[1400px] shrink-0">
        <img
            src="/indy-skyline-sketch.webp"
            srcset="/indy-skyline-sketch-768.webp 768w, /indy-skyline-sketch.webp 1536w"
            sizes="100vw"
            alt="Ink sketch of the Indianapolis skyline and canal"
            class="block h-auto w-full opacity-80 dark:invert"
            width="1536"
            height="362"
            loading="lazy"
            decoding="async"
        />
    </div>
    <LocalTime class="relative w-full py-4 text-center text-xs md:text-sm" />
</footer>
