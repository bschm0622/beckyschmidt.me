---
import LocalTime from "@/components/LocalTime.astro";
---

<footer id="skyline-footer" class="relative w-full shrink-0 overflow-hidden flex flex-col items-center">
    {/* shrink-0 prevents the flex-col body from collapsing this to 0 height */}
    <div class="relative w-full max-w-[38rem] shrink-0 px-6 md:px-4">
        <img
            src="/indy-skyline-sketch.webp"
            srcset="/indy-skyline-sketch-768.webp 768w, /indy-skyline-sketch.webp 1536w"
            sizes="(min-width: 640px) 576px, calc(100vw - 48px)"
            alt="Ink sketch of the Indianapolis skyline and canal"
            class="block h-auto w-full opacity-80 dark:invert"
            width="1536"
            height="362"
            loading="lazy"
            decoding="async"
        />
    </div>
    <LocalTime class="relative w-full py-4 text-center text-xs md:text-sm" />
</footer>
