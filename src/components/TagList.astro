---
import { slugifyStr } from "@/lib/slugify";

interface Props {
    tags: string[];
    counts?: Record<string, number>;
    class?: string;
    linked?: boolean;
}

const { tags, counts, class: className = "flex flex-wrap gap-1.5", linked = true } = Astro.props;
---

{tags.length > 0 && (
    <div class={className}>
        {tags.map((tag) => {
            const label = counts ? `${tag} (${counts[tag]})` : tag;
            return linked ? (
                <a
                    href={`/notes/tag/${slugifyStr(tag)}/`}
                    class="px-2 py-0.5 rounded bg-foreground/5 text-sm text-muted-foreground! no-underline! hover:bg-foreground/10 transition-colors"
                >
                    {label}
                </a>
            ) : (
                <span class="px-2 py-0.5 rounded bg-foreground/5 text-sm text-muted-foreground">
                    {label}
                </span>
            );
        })}
    </div>
)}
