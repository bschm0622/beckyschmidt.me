---
import { SITE, siteOrigin } from "@/siteConfig";
import { SKILLS, EDUCATION } from "@/data/career";
import { ClientRouter } from "astro:transitions";
import Favicons from "@/components/Favicons.astro";
import { Font } from "astro:assets";

interface Props {
    title?: string;
    description?: string;
    image?: URL | string;
    canonicalURL?: URL | string;
    noindex?: boolean;
}

const {
    title = "",
    description = SITE.description,
    image,
    canonicalURL,
    noindex = false,
} = Astro.props;

const origin = siteOrigin(Astro.site);

const fullTitle = title
    ? `${title} | ${SITE.name}`
    : `${SITE.name} | ${SITE.jobTitle}`;
const socialTitle = title || `${SITE.name} | ${SITE.jobTitle}`;

const imageUrl =
    typeof image === "string"
        ? image
        : (image?.toString() ?? new URL(SITE.ogImage, origin).toString());

const canonicalStr =
    typeof canonicalURL === "string"
        ? canonicalURL
        : (canonicalURL?.toString() ??
          new URL(Astro.url.pathname, origin).toString());

const shouldLoadAnalytics = import.meta.env.PROD;
---

{/* Theme color meta must come before the init script so the script can find it */}
<meta id="theme-color-meta" name="theme-color" content={SITE.themeColors.light} />

{/* Inline so the theme class is set before first paint. */}
<script is:inline define:vars={{ themeColors: SITE.themeColors }}>
    (function () {
        var theme =
            localStorage.getItem("theme-preference") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.classList.remove("light", "dark");
        document.documentElement.classList.add(theme);
        var meta = document.getElementById("theme-color-meta");
        if (meta) meta.setAttribute("content", theme === "dark" ? themeColors.dark : themeColors.light);
    })();
</script>

<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
/>
<meta name="format-detection" content="telephone=no" />
<meta name="HandheldFriendly" content="True" />
<meta name="referrer" content="no-referrer-when-downgrade" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
<meta name="author" content={SITE.author} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:url" content={canonicalStr} />
<meta property="og:locale" content={SITE.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="canonical" href={canonicalStr} />

<script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${origin}#website`,
            "url": origin.toString(),
            "name": SITE.name,
            "description": SITE.description,
            "inLanguage": SITE.locale,
            "publisher": {
                "@id": `${origin}#person`
            }
        },
        {
            "@type": "Person",
            "@id": `${origin}#person`,
            "name": SITE.name,
            "url": origin.toString(),
            "image": new URL(SITE.headshot, origin).toString(),
            "description": SITE.description,
            "email": SITE.email,
            "jobTitle": SITE.jobTitle,
            "worksFor": {
                "@type": "Organization",
                "name": SITE.employer.name,
                "url": SITE.employer.url
            },
            "address": {
                "@type": "PostalAddress",
                "addressLocality": SITE.location.locality,
                "addressRegion": SITE.location.region,
                "addressCountry": SITE.location.country
            },
            "alumniOf": {
                "@type": "CollegeOrUniversity",
                "name": EDUCATION.school,
                "url": EDUCATION.schoolUrl
            },
            "hasCredential": {
                "@type": "EducationalOccupationalCredential",
                "credentialCategory": "degree",
                "name": EDUCATION.degree,
                "recognizedBy": {
                    "@type": "CollegeOrUniversity",
                    "name": `${EDUCATION.school}, ${EDUCATION.college}`
                }
            },
            "knowsAbout": SKILLS,
            "hasOccupation": {
                "@type": "Occupation",
                "name": SITE.jobTitle,
                "skills": SKILLS.join(", ")
            },
            "sameAs": [
                SITE.socials.linkedin,
                SITE.socials.x,
                SITE.socials.github
            ]
        },
        {
            "@type": "WebPage",
            "@id": canonicalStr,
            "url": canonicalStr,
            "name": fullTitle,
            "description": description,
            "isPartOf": {
                "@id": `${origin}#website`
            },
            "inLanguage": SITE.locale
        }
    ]
})} />

<link rel="sitemap" href="/sitemap-index.xml" />

<Font cssVariable="--font-cal-sans" preload={[{ style: "normal" }]} />
<Favicons />
<ClientRouter />

{shouldLoadAnalytics && (
  <script>
    import { SITE } from "@/siteConfig";
    if (document.cookie.indexOf('umami.disabled=true') === -1) {
      const s = document.createElement('script');
      s.src = 'https://cloud.umami.is/script.js';
      s.setAttribute('data-website-id', SITE.analytics.umamiWebsiteId);
      s.defer = true;
      document.head.appendChild(s);
    }
  </script>
)}
