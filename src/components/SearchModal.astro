---
import CommandPalette from "./CommandPalette";

const key =
    "rounded-sm border border-muted bg-muted px-1.5 py-0.5 text-[calc(0.7rem*var(--type-scale))] font-medium leading-none text-muted-foreground";
---

<div
    id="search-modal-backdrop"
    class="fixed inset-0 bg-black/25 dark:bg-black/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-200"
    aria-hidden="true"
>
    <div id="search-modal-container" class="fixed inset-0 overflow-y-auto overscroll-contain">
        {/* Top-anchored, not centered, so the field doesn't move as results change height. */}
        <div class="flex min-h-full items-start justify-center p-4 md:pt-[12vh]">
            <div
                id="search-modal-content"
                class="relative w-full max-w-2xl min-w-0 bg-surface rounded-md border border-muted shadow-lg transform scale-95 transition-transform duration-200"
                role="dialog"
                aria-modal="true"
                aria-labelledby="search-modal-title"
            >
                <div class="p-6">
                    <h2 id="search-modal-title" class="sr-only">Command palette</h2>
                    <CommandPalette maxHeight="60vh" client:visible />
                </div>

                <div class="hidden md:flex items-center justify-between border-t border-muted px-6 py-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-4">
                        <span class="flex items-center gap-1.5">
                            <kbd class={key}>↑</kbd><kbd class={key}>↓</kbd>
                            <span>navigate</span>
                        </span>
                        <span class="flex items-center gap-1.5">
                            <kbd class={key}>↵</kbd>
                            <span>select</span>
                        </span>
                    </div>
                    <span class="flex items-center gap-1.5">
                        <kbd class={key}>esc</kbd>
                        <span>close</span>
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function initSearchModal() {
        const backdrop = document.getElementById("search-modal-backdrop");
        const container = document.getElementById("search-modal-container");
        const content = document.getElementById("search-modal-content");

        if (!backdrop || !container || !content) return;

        // A result can navigate away with the modal still open; release the scroll lock.
        document.documentElement.style.overflow = "";

        const ANIMATION_DURATION = 200;
        const FOCUS_DELAY = 100;

        const elements = { backdrop, container, content };

        let previouslyFocused: HTMLElement | null = null;

        const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';

        function openModal() {
            previouslyFocused = document.activeElement as HTMLElement | null;
            document.documentElement.style.overflow = "hidden";
            elements.backdrop.classList.remove("hidden");
            elements.backdrop.setAttribute("aria-hidden", "false");
            void elements.backdrop.offsetHeight;
            elements.backdrop.classList.remove("opacity-0");
            elements.content.classList.remove("scale-95");
            elements.content.classList.add("scale-100");

            setTimeout(() => {
                const searchInput = elements.content.querySelector(
                    'input[type="text"]',
                ) as HTMLInputElement;
                searchInput?.focus();
            }, FOCUS_DELAY);
        }

        function closeModal() {
            document.documentElement.style.overflow = "";
            elements.backdrop.classList.add("opacity-0");
            elements.backdrop.setAttribute("aria-hidden", "true");
            elements.content.classList.remove("scale-100");
            elements.content.classList.add("scale-95");
            setTimeout(() => elements.backdrop.classList.add("hidden"), ANIMATION_DURATION);
            previouslyFocused?.focus();
        }

        function trapFocus(e: KeyboardEvent) {
            if (e.key !== "Tab") return;
            const focusable = Array.from(
                elements.content.querySelectorAll<HTMLElement>(FOCUSABLE),
            ).filter((el) => el.offsetParent !== null);
            if (focusable.length === 0) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            const active = document.activeElement;

            if (e.shiftKey && active === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && active === last) {
                e.preventDefault();
                first.focus();
            }
        }

        window.openSearchModal = openModal;
        window.closeSearchModal = closeModal;

        elements.content.addEventListener("click", (e) => {
            e.stopPropagation();
        });

        elements.container.addEventListener("click", () => {
            closeModal();
        });

        isModalOpen = () => !elements.backdrop.classList.contains("hidden");
        trapFocusInModal = trapFocus;
    }

    let isModalOpen = () => false;
    let trapFocusInModal: (e: KeyboardEvent) => void = () => {};

    // Bound here, not in initSearchModal, which runs per navigation and would pile up listeners.
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isModalOpen()) {
            window.closeSearchModal?.();
        }

        if (isModalOpen()) {
            trapFocusInModal(e);
        }

        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
            e.preventDefault();
            window.openSearchModal?.();
        }
    });

    document.addEventListener("astro:page-load", initSearchModal);
</script>
