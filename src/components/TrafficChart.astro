---
// Daily page views as bars; hover or focus a bar for that day's numbers. Used on the colophon and /admin/analytics.
import type { DayTraffic } from "@/lib/analytics/stats";

interface Props {
    data: DayTraffic[];
    /** Distinct visitors over the whole range; adding up daily counts would count a repeat visitor twice. */
    visitors: number;
}

const { data, visitors: totalVisitors } = Astro.props;
const max = Math.max(...data.map((d) => d.views), 1);
const totalViews = data.reduce((sum, d) => sum + d.views, 0);
const label = (day: string) =>
    new Date(`${day}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const plural = (n: number, word: string) => `${n.toLocaleString("en-US")} ${word}${n === 1 ? "" : "s"}`;
---

<figure class="m-0">
    <figcaption class="mb-3 text-sm text-muted-foreground tabular-nums">
        {plural(totalViews, "view")} · {plural(totalVisitors, "visitor")}
    </figcaption>
    <div class:list={["flex h-32 items-end", data.length <= 90 && "gap-0.5"]} role="list" aria-label="Page views per day">
        {data.map((d) => (
            <div
                class="group relative flex h-full flex-1 items-end outline-none"
                role="listitem"
                tabindex="0"
                aria-label={`${label(d.day)}: ${plural(d.views, "view")}, ${plural(d.visitors, "visitor")}`}
            >
                <div
                    class:list={[
                        "w-full rounded-t-sm transition-colors",
                        d.views ? "bg-foreground/25 group-hover:bg-foreground/60 group-focus-visible:bg-foreground/60" : "bg-foreground/8",
                    ]}
                    style={`height: ${d.views ? Math.max((d.views / max) * 100, 3) : 1.5}%`}
                />
                <div class="traffic-tip pointer-events-none absolute bottom-full z-10 mb-2 hidden whitespace-nowrap rounded-md bg-foreground px-2 py-1 text-xs text-background group-hover:block group-focus-visible:block">
                    {label(d.day)} · {plural(d.views, "view")} · {plural(d.visitors, "visitor")}
                </div>
            </div>
        ))}
    </div>
    <div class="mt-2 flex justify-between text-xs text-faint-foreground tabular-nums">
        <span>{label(data[0].day)}</span>
        <span>{label(data[data.length - 1].day)}</span>
    </div>
</figure>

<style>
    /* Center tips over their bar, but pin the ones at the edges so they never leave the chart. */
    .traffic-tip {
        left: 50%;
        transform: translateX(-50%);
    }
    [role="listitem"]:nth-child(-n + 5) .traffic-tip {
        left: 0;
        transform: none;
    }
    [role="listitem"]:nth-last-child(-n + 5) .traffic-tip {
        left: auto;
        right: 0;
        transform: none;
    }
</style>
