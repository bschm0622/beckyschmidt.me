---
import { SITE } from "@/siteConfig";

---

<button
    type="button"
    aria-label="Toggle theme"
    class="theme-toggle-btn relative flex items-center justify-center w-10 h-10 rounded-lg transition-[background-color] cursor-pointer hover:bg-foreground/13 text-foreground"
>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="absolute inset-0 m-auto transition-[opacity,scale,rotate] duration-300 opacity-100 dark:opacity-0 motion-safe:scale-100 motion-safe:rotate-0 motion-safe:dark:scale-0 motion-safe:dark:-rotate-90" xmlns="http://www.w3.org/2000/svg">
        <path d="M21.5 14.0784C20.3003 14.7189 18.9301 15.0821 17.4751 15.0821C12.7491 15.0821 8.91792 11.2509 8.91792 6.52485C8.91792 5.06986 9.28105 3.69968 9.92163 2.5C5.66765 3.49698 2.5 7.31513 2.5 11.8731C2.5 17.1899 6.8101 21.5 12.1269 21.5C16.6849 21.5 20.503 18.3324 21.5 14.0784Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="absolute inset-0 m-auto transition-[opacity,scale,rotate] duration-300 opacity-0 dark:opacity-100 motion-safe:scale-0 motion-safe:rotate-90 motion-safe:dark:scale-100 motion-safe:dark:rotate-0" xmlns="http://www.w3.org/2000/svg">
        <path d="M17 12C17 14.7614 14.7614 17 12 17C9.23858 17 7 14.7614 7 12C7 9.23858 9.23858 7 12 7C14.7614 7 17 9.23858 17 12Z" stroke="currentColor" stroke-width="2"/>
        <path d="M12 2V3.5M12 20.5V22M19.0708 19.0713L18.0101 18.0106M5.98926 5.98926L4.9286 4.9286M22 12H20.5M3.5 12H2M19.0713 4.92871L18.0106 5.98937M5.98975 18.0107L4.92909 19.0714" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <span class="sr-only">Toggle theme</span>
</button>

<script is:inline define:vars={{ themeColors: SITE.themeColors }}>
    // Re-runs on every navigation, so bind once and delegate, or one click toggles twice.
    if (!window.__themeBound) {
        window.__themeBound = true;

        // Only explicit toggles are stored (else follow the system); key must match BaseHead.astro.
        const KEY = "theme-preference";
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
        const currentTheme = () =>
            localStorage.getItem(KEY) || (systemDark.matches ? "dark" : "light");

        const applyTheme = (root, theme) => {
            root.classList.remove("light", "dark");
            root.classList.add(theme);
        };
        const updateThemeColor = (theme) => {
            const meta = document.getElementById("theme-color-meta");
            if (meta) meta.setAttribute("content", theme === "dark" ? themeColors.dark : themeColors.light);
        };

        document.addEventListener("click", (event) => {
            if (!event.target.closest(".theme-toggle-btn")) return;
            const next = document.documentElement.classList.contains("dark") ? "light" : "dark";
            localStorage.setItem(KEY, next);
            applyTheme(document.documentElement, next);
            updateThemeColor(next);
        });

        // Theme the incoming document before swap so the transition never flashes.
        document.addEventListener("astro:before-swap", (event) => {
            applyTheme(event.newDocument.documentElement, currentTheme());
        });

        // The theme-color meta is replaced on swap, so sync it after.
        document.addEventListener("astro:after-swap", () => updateThemeColor(currentTheme()));

        systemDark.addEventListener("change", () => {
            if (localStorage.getItem(KEY)) return;
            applyTheme(document.documentElement, currentTheme());
            updateThemeColor(currentTheme());
        });
    }
</script>
