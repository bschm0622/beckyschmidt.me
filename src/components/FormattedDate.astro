---
import { formatDate } from "@/lib/notes";

interface Props {
    date: Date;
    class?: string;
    /** "month-year" renders e.g. "Aug 2026" for compact contexts. */
    variant?: "full" | "month-year";
}

const { date, class: className, variant = "full" } = Astro.props;
---

<time datetime={date.toISOString()} class={className}>
    {formatDate(date, variant)}
</time>
