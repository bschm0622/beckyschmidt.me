---
// A ranked list for /admin/analytics: label, optional detail, count, with a faint bar showing share of the top row.
import type { Row } from "@/lib/analytics/stats";

interface Props {
    title: string;
    rows: Row[];
    empty?: string;
    note?: string;
}

const { title, rows, empty = "Nothing yet.", note } = Astro.props;
const max = Math.max(...rows.map((r) => r.count), 1);
---

<section class="min-w-0 space-y-2">
    <h2 class="text-sm font-medium text-muted-foreground">{title}</h2>
    {rows.length === 0 ? (
        <p class="text-sm text-faint-foreground">{empty}</p>
    ) : (
        <ul class="space-y-0.5">
            {rows.map((r) => (
                <li class="relative flex items-baseline justify-between gap-4 rounded-md px-2 py-1.5 text-sm">
                    <span class="absolute inset-y-0 left-0 rounded-md bg-foreground/5" style={`width: ${(r.count / max) * 100}%`} aria-hidden="true" />
                    <span class="relative min-w-0 truncate text-foreground" title={r.detail ? `${r.label} · ${r.detail}` : r.label}>
                        {r.label}
                        {r.detail && <span class="text-faint-foreground"> · {r.detail}</span>}
                    </span>
                    <span class="relative shrink-0 tabular-nums text-muted-foreground">{r.count.toLocaleString("en-US")}</span>
                </li>
            ))}
        </ul>
    )}
    {note && <p class="px-2 text-sm text-faint-foreground">{note}</p>}
</section>
