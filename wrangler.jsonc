{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "becky-schmidt-personal-site",
  // Unified server entrypoint provided by @astrojs/cloudflare.
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Must be >= 2026-02-19, when the `fetch_iterable_type_support` flag became
  // default-on. Astro 7 streams pages as an async iterable Response body; older
  // workerd stringified that to "[object Object]", so every prerendered page was
  // emitted as a 15-byte stub. Matches @astrojs/cloudflare v14's own default.
  "compatibility_date": "2026-04-15",
  // Required for node:crypto + Buffer used by the cookie-signing in src/lib/session.ts.
  "compatibility_flags": ["nodejs_compat"],
  // Astro's build output; static files are served directly, SSR routes hit the Worker.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Self-hosted analytics (src/lib/analytics/). Schema lives in migrations/; apply with
  // `npx wrangler d1 migrations apply DB --remote` before deploying a schema change.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beckyschmidt-analytics",
      "database_id": "c94f53ca-73c0-46cc-a140-eb3443a9ee7f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
